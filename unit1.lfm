  object TrayMenu: TPopupMenu
    Left = 80
    Top = 584
    object ShowMenuItem: TMenuItem
      Caption = 'Mostrar LaguNETbi'
      Default = True
      OnClick = ShowFromTray
    end
    object HideMenuItem: TMenuItem
      Caption = 'Ocultar ventana'
      OnClick = HideToTray
    end
    object TraySeparator: TMenuItem
      Caption = '-'
    end
    object ExitMenuItem: TMenuItem
      Caption = 'Salir'
      OnClick = ExitFromTray
    end
  end
  object TrayIcon: TTrayIcon
    Left = 144
    Top = 584
    Hint = 'LaguNETbi - Doble clic para abrir'
    PopUpMenu = TrayMenu
    OnDblClick = ShowFromTray
  end
end
