object Form1: TForm1
  Left = 200
  Top = 120
  Width = 860
  Height = 640
  Caption = 'LaguNETbi - Prueba de estetica'
  ClientHeight = 640
  ClientWidth = 860
  Font.Name = 'Segoe UI'
  Font.Size = 10
  Position = poScreenCenter
  BorderStyle = bsSingle
  BorderIcons = [biSystemMenu, biMinimize]
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  OnClose = FormClose
  object Sidebar: TPanel
    Left = 0
    Top = 0
    Width = 248
    Height = 640
    BevelOuter = bvNone
    Color = 3350804
