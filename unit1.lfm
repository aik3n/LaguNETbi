      Top = 405
      Width = 400
      Height = 24
      Caption = '3 perfiles de ejemplo'
      Font.Size = 10
      Font.Color = 13153442
      ParentFont = False
    end
    object VersionLabel: TLabel
      Left = 26
      Top = 540
      Width = 400
      Height = 24
      Caption = 'LaguNETbi  /  Concepto 01'
      Font.Size = 9
      Font.Color = 13153442
      ParentFont = False
    end
  end
