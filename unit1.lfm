      Font.Color = clWhite
      ParentFont = False
      Font.Style = [fsBold]
    end
    object TaglineLabel: TLabel
      Left = 26
      Top = 72
      Width = 400
      Height = 24
      Caption = 'bi  /  Tu red, a tu manera'
      Font.Size = 10
      Font.Color = 13153442
      ParentFont = False
    end
    object ProfilesLabel: TLabel
      Left = 26
      Top = 144
      Width = 400
      Height = 24
      Caption = 'MIS PERFILES'
      Font.Size = 9
      Font.Color = 13153442
      ParentFont = False
    end
    object ProfileList: TListBox
      Left = 16
      Top = 179
      Width = 216
      Height = 195
      BorderStyle = bsNone
      Color = 3350804
      Font.Color = clWhite
      Font.Size = 12
      ParentFont = False
      ItemHeight = 44
      Style = lbOwnerDrawFixed
      Items.Strings = (
        '   Oficina'
        '   Casa'
        '   Laboratorio'
      )
      ItemIndex = 0
      OnClick = SelectProfile
      TabOrder = 0
    end
    object CountLabel: TLabel
