unit uSettingsForm;{$mode objfpc}{$H+}interfaceuses  Windows, ShellApi, Classes, SysUtils, Forms, Controls, Graphics, Dialogs,  StdCtrls, uWindowsSupport;type  TSettingsForm = class(TForm)    TitleLabel: TLabel;    SubtitleLabel: TLabel;    IntroLabel: TLabel;    SettingsGroup: TGroupBox;    StartupCheck: TCheckBox;    ShowBatContentCheck: TCheckBox;    StartupStatus: TLabel;    CreditsGroup: TGroupBox;    CreditsLabel: TLabel;    RepositoryButton: TButton;    CloseButton: TButton;    procedure FormCreate(Sender: TObject);    procedure StartupCheckClick(Sender: TObject);    procedure ShowBatContentCheckClick(Sender: TObject);    procedure RepositoryButtonClick(Sender: TObject);  private    FUpdating: Boolean;    FOnShowBatContentChanged: TNotifyEvent;    function GetShowBatContent: Boolean;    procedure SetShowBatContent(AValue: Boolean);    procedure RefreshStartupState;  public    property ShowBatContent: Boolean      read GetShowBatContent write SetShowBatContent;    property OnShowBatContentChanged: TNotifyEvent      read FOnShowBatContentChanged write FOnShowBatContentChanged;  end;implementation{$R *.lfm}procedure TSettingsForm.FormCreate(Sender: TObject);begin  RefreshStartupState;end;procedure TSettingsForm.RefreshStartupState;begin  FUpdating := True;  try    StartupCheck.Checked := LaguNETbiStartupTaskExists;    if StartupCheck.Checked then    begin      if LaguNETbiIsElevated then        StartupStatus.Caption :=          'Activo. LaguNETbi se ha iniciado con privilegios y no necesita ' +          'pedir permiso para cada cambio de red.'      else        StartupStatus.Caption :=          'Activo para el proximo inicio de LaguNETbi. La sesion actual ' +          'seguira pidiendo permiso cuando una operacion lo necesite.';    end    else    begin      if LaguNETbiIsElevated then        StartupStatus.Caption :=          'Desactivado para proximos inicios. Esta sesion conserva sus ' +          'privilegios hasta que salgas de LaguNETbi.'      else        StartupStatus.Caption :=          'Desactivado. LaguNETbi solo pedira permiso cuando una operacion ' +          'de red necesite privilegios.';    end;  finally    FUpdating := False;  end;end;procedure TSettingsForm.StartupCheckClick(Sender: TObject);var  Wanted: Boolean;  ErrorText: String;begin  if FUpdating then    Exit;  Wanted := StartupCheck.Checked;  StartupCheck.Enabled := False;  StartupStatus.Caption := 'Aplicando...';  Application.ProcessMessages;  try    if not LaguNETbiChangeStartupTask(Wanted, ErrorText) then    begin      MessageDlg(        'No se pudo cambiar el inicio con Windows.' + LineEnding +        ErrorText,        mtError, [mbOK], 0      );    end;  finally    StartupCheck.Enabled := True;    RefreshStartupState;  end;end;procedure TSettingsForm.ShowBatContentCheckClick(Sender: TObject);begin  if FUpdating then    Exit;  if Assigned(FOnShowBatContentChanged) then    FOnShowBatContentChanged(Self);end;function TSettingsForm.GetShowBatContent: Boolean;begin  Result := ShowBatContentCheck.Checked;end;procedure TSettingsForm.SetShowBatContent(AValue: Boolean);begin  FUpdating := True;  try    ShowBatContentCheck.Checked := AValue;  finally    FUpdating := False;  end;end;procedure TSettingsForm.RepositoryButtonClick(Sender: TObject);begin  ShellExecute(    Handle,    'open',    'https://github.com/aik3n/LaguNETbi',    nil,    nil,    SW_SHOWNORMAL  );end;end.