unit uSettingsForm;{$mode objfpc}{$H+}interfaceuses  Windows, ShellApi, Classes, SysUtils, Forms, Controls, Graphics, Dialogs,  StdCtrls, uWindowsSupport, uLanguage;type  TSettingsForm = class(TForm)    TitleLabel: TLabel;    SubtitleLabel: TLabel;    IntroLabel: TLabel;    SettingsGroup: TGroupBox;    StartupCheck: TCheckBox;    LanguageLabel: TLabel;    LanguageCombo: TComboBox;    ShowBatContentCheck: TCheckBox;    StartupStatus: TLabel;    CreditsGroup: TGroupBox;    CreditsLabel: TLabel;    RepositoryButton: TButton;    CloseButton: TButton;    procedure FormCreate(Sender: TObject);    procedure StartupCheckClick(Sender: TObject);    procedure LanguageComboChange(Sender: TObject);    procedure ShowBatContentCheckClick(Sender: TObject);    procedure RepositoryButtonClick(Sender: TObject);  private    FUpdating: Boolean;    FOnShowBatContentChanged: TNotifyEvent;    FOnLanguageChanged: TNotifyEvent;    procedure ApplyLanguage;    function GetShowBatContent: Boolean;    procedure SetShowBatContent(AValue: Boolean);    procedure RefreshStartupState;  public    property OnLanguageChanged: TNotifyEvent      read FOnLanguageChanged write FOnLanguageChanged;    property ShowBatContent: Boolean      read GetShowBatContent write SetShowBatContent;    property OnShowBatContentChanged: TNotifyEvent      read FOnShowBatContentChanged write FOnShowBatContentChanged;  end;implementation{$R *.lfm}procedure TSettingsForm.FormCreate(Sender: TObject);begin  RefreshStartupState;end;procedure TSettingsForm.RefreshStartupState;begin  FUpdating := True;  try    StartupCheck.Checked := LaguNETbiStartupTaskExists;    if StartupCheck.Checked then    begin      if LaguNETbiIsElevated then        StartupStatus.Caption :=          'Activo. LaguNETbi se ha iniciado con privilegios y no necesita ' +          'pedir permiso para cada cambio de red.'      else        StartupStatus.Caption :=          'Activo para el proximo inicio de LaguNETbi. La sesion actual ' +          'seguira pidiendo permiso cuando una operacion lo necesite.';    end    else    begin      if LaguNETbiIsElevated then        StartupStatus.Caption :=          'Desactivado para proximos inicios. Esta sesion conserva sus ' +          'privilegios hasta que salgas de LaguNETbi.'      else        StartupStatus.Caption :=          'Desactivado. LaguNETbi solo pedira permiso cuando una operacion ' +          'de red necesite privilegios.';    end;  finally    FUpdating := False;  end;  ApplyLanguage;end;procedure TSettingsForm.ApplyLanguage;var  Index: Integer;begin  Caption := LanguageText('Settings', 'Title', 'Help / Settings');  SubtitleLabel.Caption := LanguageText('Settings', 'Subtitle',    'Quick network configuration for Windows');  IntroLabel.Caption := LanguageText('Settings', 'Intro',    'Designed for frequent network changes without allowing arbitrary commands.');  SettingsGroup.Caption := LanguageText('Settings', 'Group', ' Settings ');  StartupCheck.Caption := LanguageText('Settings', 'Startup',    'Start with Windows as administrator');  ShowBatContentCheck.Caption := LanguageText('Settings', 'ShowBat', 'Show BAT contents');  CreditsGroup.Caption := LanguageText('Settings', 'Credits', ' About / Credits ');  CreditsLabel.Caption := LanguageText('Settings', 'CreditsText',    'LaguNETbi: rewritten using Lazarus / Free Pascal. Based on the original LaguNET. Open-source project.');  RepositoryButton.Caption := LanguageText('Settings', 'Repository', 'Open GitHub');  CloseButton.Caption := LanguageText('Settings', 'Close', 'Close');  LanguageLabel.Caption := LanguageText('Settings', 'Language', 'Interface language');  FUpdating := True;  try    LanguageCombo.Items.BeginUpdate;    try      LanguageCombo.Items.Clear;      LanguageCombo.Items.Add(LanguageText('Settings', 'Automatic',        'Automatic (Windows language)'));      LanguageCombo.Items.Add('English');      LanguageCombo.Items.Add('Español');      if LanguageSelected = 'eng' then        Index := 1      else if LanguageSelected = 'spa' then        Index := 2      else        Index := 0;      LanguageCombo.ItemIndex := Index;    finally      LanguageCombo.Items.EndUpdate;    end;  finally    FUpdating := False;  end;  if StartupCheck.Checked then  begin    if LaguNETbiIsElevated then      StartupStatus.Caption := LanguageText('Settings', 'StartupActiveAdmin',        'Enabled. LaguNETbi is running with administrator privileges.')    else      StartupStatus.Caption := LanguageText('Settings', 'StartupActiveNormal',        'Enabled for the next start. This session may still request permission.');  end  else  begin    if LaguNETbiIsElevated then      StartupStatus.Caption := LanguageText('Settings', 'StartupOffAdmin',        'Disabled for this copy. Current privileges remain until exit.')    else      StartupStatus.Caption := LanguageText('Settings', 'StartupOffNormal',        'Disabled for this copy. Network changes may request permission.');  end;end;procedure TSettingsForm.LanguageComboChange(Sender: TObject);var  Code: String;begin  if FUpdating then    Exit;  case LanguageCombo.ItemIndex of    1: Code := 'eng';    2: Code := 'spa';    else Code := 'auto';  end;  if not LanguageSetSelection(Code) then  begin    MessageDlg(LanguageText('Settings', 'SaveError',      'Could not save language preference.'), mtError, [mbOK], 0);    ApplyLanguage;    Exit;  end;  if Assigned(FOnLanguageChanged) then    FOnLanguageChanged(Self);  ApplyLanguage;end;procedure TSettingsForm.StartupCheckClick(Sender: TObject);var  Wanted: Boolean;  ErrorText: String;begin  if FUpdating then    Exit;  Wanted := StartupCheck.Checked;  StartupCheck.Enabled := False;  StartupStatus.Caption := 'Aplicando...';  Application.ProcessMessages;  try    if not LaguNETbiChangeStartupTask(Wanted, ErrorText) then    begin      MessageDlg(        'No se pudo cambiar el inicio con Windows.' + LineEnding +        ErrorText,        mtError, [mbOK], 0      );    end;  finally    StartupCheck.Enabled := True;    RefreshStartupState;  end;end;procedure TSettingsForm.ShowBatContentCheckClick(Sender: TObject);begin  if FUpdating then    Exit;  if Assigned(FOnShowBatContentChanged) then    FOnShowBatContentChanged(Self);end;function TSettingsForm.GetShowBatContent: Boolean;begin  Result := ShowBatContentCheck.Checked;end;procedure TSettingsForm.SetShowBatContent(AValue: Boolean);begin  FUpdating := True;  try    ShowBatContentCheck.Checked := AValue;  finally    FUpdating := False;  end;end;procedure TSettingsForm.RepositoryButtonClick(Sender: TObject);begin  ShellExecute(    Handle,    'open',    'https://github.com/aik3n/LaguNETbi',    nil,    nil,    SW_SHOWNORMAL  );end;end.