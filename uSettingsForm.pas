unit uSettingsForm;{$mode objfpc}{$H+}interfaceuses  Windows, ShellApi, Classes, SysUtils, Forms, Controls, Graphics, Dialogs,  StdCtrls, uWindowsSupport, uLanguage, uLanguageRepo;type  TSettingsForm = class(TForm)    TitleLabel: TLabel;    SubtitleLabel: TLabel;    IntroLabel: TLabel;    SettingsGroup: TGroupBox;    StartupCheck: TCheckBox;    LanguageLabel: TLabel;    LanguageCombo: TComboBox;    LanguageSearchButton: TButton;    ShowBatContentCheck: TCheckBox;    StartupStatus: TLabel;    CreditsGroup: TGroupBox;    CreditsLabel: TLabel;    RepositoryButton: TButton;    CloseButton: TButton;    procedure FormCreate(Sender: TObject);    procedure StartupCheckClick(Sender: TObject);    procedure LanguageComboChange(Sender: TObject);    procedure LanguageSearchClick(Sender: TObject);    procedure LanguageNetworkFinished(Sender: TObject);    procedure FormDestroy(Sender: TObject);    procedure ShowBatContentCheckClick(Sender: TObject);    procedure RepositoryButtonClick(Sender: TObject);  private    FUpdating: Boolean;    FOnShowBatContentChanged: TNotifyEvent;    FOnLanguageChanged: TNotifyEvent;    FRemoteFiles: TStringList;    FChoiceCodes: TStringList;    FChoiceFiles: TStringList;    FNetwork: TLanguageRepoThread;    FPendingCode: String;    procedure ApplyLanguage;    procedure FillLanguageChoices;    procedure StartLanguageNetwork(AAction: TLanguageRepoAction;      const ACode, AFileName: String);    function GetShowBatContent: Boolean;    procedure SetShowBatContent(AValue: Boolean);    procedure RefreshStartupState;  public    property OnLanguageChanged: TNotifyEvent      read FOnLanguageChanged write FOnLanguageChanged;    property ShowBatContent: Boolean      read GetShowBatContent write SetShowBatContent;    property OnShowBatContentChanged: TNotifyEvent      read FOnShowBatContentChanged write FOnShowBatContentChanged;  end;implementation{$R *.lfm}procedure TSettingsForm.FormCreate(Sender: TObject);begin  FRemoteFiles := TStringList.Create;  FChoiceCodes := TStringList.Create;  FChoiceFiles := TStringList.Create;  FNetwork := nil;  RefreshStartupState;end;procedure TSettingsForm.FormDestroy(Sender: TObject);begin  { El worker no accede al formulario; su evento no debe sobrevivirlo. }  if Assigned(FNetwork) then  begin    FNetwork.OnTerminate := nil;    FNetwork.Terminate;    FNetwork := nil;  end;  FRemoteFiles.Free;  FChoiceCodes.Free;  FChoiceFiles.Free;end;procedure TSettingsForm.RefreshStartupState;begin  FUpdating := True;  try    StartupCheck.Checked := LaguNETbiStartupTaskExists;    if StartupCheck.Checked then    begin      if LaguNETbiIsElevated then        StartupStatus.Caption :=          'Activo. LaguNETbi se ha iniciado con privilegios y no necesita ' +          'pedir permiso para cada cambio de red.'      else        StartupStatus.Caption :=          'Activo para el proximo inicio de LaguNETbi. La sesion actual ' +          'seguira pidiendo permiso cuando una operacion lo necesite.';    end    else    begin      if LaguNETbiIsElevated then        StartupStatus.Caption :=          'Desactivado para proximos inicios. Esta sesion conserva sus ' +          'privilegios hasta que salgas de LaguNETbi.'      else        StartupStatus.Caption :=          'Desactivado. LaguNETbi solo pedira permiso cuando una operacion ' +          'de red necesite privilegios.';    end;  finally    FUpdating := False;  end;  ApplyLanguage;end;procedure TSettingsForm.ApplyLanguage;begin  Caption := LanguageText('Settings', 'Title', 'Help / Settings');  SubtitleLabel.Caption := LanguageText('Settings', 'Subtitle',    'Quick network configuration for Windows');  IntroLabel.Caption := LanguageText('Settings', 'Intro',    'Designed for frequent network changes without allowing arbitrary commands.');  SettingsGroup.Caption := LanguageText('Settings', 'Group', ' Settings ');  StartupCheck.Caption := LanguageText('Settings', 'Startup',    'Start with Windows as administrator');  ShowBatContentCheck.Caption := LanguageText('Settings', 'ShowBat', 'Show BAT contents');  CreditsGroup.Caption := LanguageText('Settings', 'Credits', ' About / Credits ');  CreditsLabel.Caption := LanguageText('Settings', 'CreditsText',    'LaguNETbi: rewritten using Lazarus / Free Pascal. Based on the original LaguNET. Open-source project.');  RepositoryButton.Caption := LanguageText('Settings', 'Repository', 'Open GitHub');  CloseButton.Caption := LanguageText('Settings', 'Close', 'Close');  LanguageLabel.Caption := LanguageText('Settings', 'Language', 'Interface language');  if not Assigned(FNetwork) then    LanguageSearchButton.Caption := LanguageText('Settings', 'Search',      'Search languages');  FillLanguageChoices;  if StartupCheck.Checked then  begin    if LaguNETbiIsElevated then      StartupStatus.Caption := LanguageText('Settings', 'StartupActiveAdmin',        'Enabled. LaguNETbi is running with administrator privileges.')    else      StartupStatus.Caption := LanguageText('Settings', 'StartupActiveNormal',        'Enabled for the next start. This session may still request permission.');  end  else  begin    if LaguNETbiIsElevated then      StartupStatus.Caption := LanguageText('Settings', 'StartupOffAdmin',        'Disabled for this copy. Current privileges remain until exit.')    else      StartupStatus.Caption := LanguageText('Settings', 'StartupOffNormal',        'Disabled for this copy. Network changes may request permission.');  end;end;procedure TSettingsForm.FillLanguageChoices;var  LocalFiles: TStringList;  I, Index: Integer;  FileName, Code, DisplayName: String;  procedure AddChoice(const ACode, AFile, ADisplay: String);  begin    if FChoiceCodes.IndexOf(ACode) >= 0 then Exit;    FChoiceCodes.Add(ACode);    FChoiceFiles.Add(AFile);    LanguageCombo.Items.Add(ADisplay);  end;begin  LocalFiles := TStringList.Create;  FUpdating := True;  try    LanguageRepoLocalFiles(LocalFiles);    LocalFiles.Sort;    FRemoteFiles.Sort;    LanguageCombo.Items.BeginUpdate;    try      LanguageCombo.Items.Clear;      FChoiceCodes.Clear;      FChoiceFiles.Clear;      AddChoice('auto', '', LanguageText('Settings', 'Automatic',        'Automatic (Windows language)'));      AddChoice('eng', 'eng-English.ini', 'English');      for I := 0 to LocalFiles.Count + FRemoteFiles.Count - 1 do      begin        if I < LocalFiles.Count then          FileName := LocalFiles[I]        else          FileName := FRemoteFiles[I - LocalFiles.Count];        Code := LanguageRepoCode(FileName);        if (Code = '') or (Code = 'eng') then Continue;        DisplayName := Copy(FileName, 5, Length(FileName) - 8);        AddChoice(Code, FileName, DisplayName);      end;      Index := FChoiceCodes.IndexOf(LanguageSelected);      if Index < 0 then Index := 0;      LanguageCombo.ItemIndex := Index;    finally      LanguageCombo.Items.EndUpdate;    end;  finally    FUpdating := False;    LocalFiles.Free;  end;end;procedure TSettingsForm.StartLanguageNetwork(AAction: TLanguageRepoAction;  const ACode, AFileName: String);begin  if Assigned(FNetwork) then Exit;  FPendingCode := ACode;  LanguageCombo.Enabled := False;  LanguageSearchButton.Enabled := False;  if AAction = lraSearch then    LanguageSearchButton.Caption := LanguageText('Settings', 'Searching',      'Searching...')  else    LanguageSearchButton.Caption := LanguageText('Settings', 'Downloading',      'Downloading...');  FNetwork := TLanguageRepoThread.Create(AAction, ACode, AFileName);  FNetwork.OnTerminate := @LanguageNetworkFinished;  FNetwork.Start;end;procedure TSettingsForm.LanguageSearchClick(Sender: TObject);begin  StartLanguageNetwork(lraSearch, '', '');end;procedure TSettingsForm.LanguageNetworkFinished(Sender: TObject);var  RepoAction: TLanguageRepoAction;  ErrorText, Code: String;begin  if not Assigned(FNetwork) or (Sender <> FNetwork) then Exit;  RepoAction := FNetwork.Action;  ErrorText := FNetwork.ErrorText;  Code := FPendingCode;  if (ErrorText = '') and (RepoAction = lraSearch) then    FRemoteFiles.Assign(FNetwork.Files);  FNetwork := nil;  { FreeOnTerminate: el propio hilo se libera al retornar. }  LanguageCombo.Enabled := True;  LanguageSearchButton.Enabled := True;  if ErrorText <> '' then  begin    if RepoAction = lraSearch then      MessageDlg(LanguageText('Settings', 'SearchFailed',        'Could not retrieve languages from GitHub.') + LineEnding +        ErrorText, mtWarning, [mbOK], 0)    else      MessageDlg(LanguageText('Settings', 'DownloadFailed',        'Could not install the selected language.') + LineEnding +        ErrorText, mtWarning, [mbOK], 0);  end  else if RepoAction = lraSearch then  begin    if FRemoteFiles.Count = 0 then      MessageDlg(LanguageText('Settings', 'NoLanguages',        'No languages were found on GitHub.'), mtInformation, [mbOK], 0);  end  else if not LanguageSetSelection(Code) then    MessageDlg(LanguageText('Settings', 'SaveError',      'Could not save language preference.'), mtError, [mbOK], 0)  else  begin    { Si ya estaba seleccionado y faltaba el archivo, hay que recargar. }    LanguageReload;    if Assigned(FOnLanguageChanged) then      FOnLanguageChanged(Self);  end;  ApplyLanguage;end;procedure TSettingsForm.LanguageComboChange(Sender: TObject);var  Code, FileName: String;  Index: Integer;begin  if FUpdating or Assigned(FNetwork) then Exit;  Index := LanguageCombo.ItemIndex;  if (Index < 0) or (Index >= FChoiceCodes.Count) then Exit;  Code := FChoiceCodes[Index];  FileName := FChoiceFiles[Index];  if (Code <> 'auto') and (Code <> 'eng') and     (LanguageRepoLocalFile(Code) = '') then  begin    StartLanguageNetwork(lraDownload, Code, FileName);    Exit;  end;  if not LanguageSetSelection(Code) then  begin    MessageDlg(LanguageText('Settings', 'SaveError',      'Could not save language preference.'), mtError, [mbOK], 0);    ApplyLanguage;    Exit;  end;  if Assigned(FOnLanguageChanged) then    FOnLanguageChanged(Self);  ApplyLanguage;end;procedure TSettingsForm.StartupCheckClick(Sender: TObject);var  Wanted: Boolean;  ErrorText: String;begin  if FUpdating then    Exit;  Wanted := StartupCheck.Checked;  StartupCheck.Enabled := False;  StartupStatus.Caption := 'Aplicando...';  Application.ProcessMessages;  try    if not LaguNETbiChangeStartupTask(Wanted, ErrorText) then    begin      MessageDlg(        'No se pudo cambiar el inicio con Windows.' + LineEnding +        ErrorText,        mtError, [mbOK], 0      );    end;  finally    StartupCheck.Enabled := True;    RefreshStartupState;  end;end;procedure TSettingsForm.ShowBatContentCheckClick(Sender: TObject);begin  if FUpdating then    Exit;  if Assigned(FOnShowBatContentChanged) then    FOnShowBatContentChanged(Self);end;function TSettingsForm.GetShowBatContent: Boolean;begin  Result := ShowBatContentCheck.Checked;end;procedure TSettingsForm.SetShowBatContent(AValue: Boolean);begin  FUpdating := True;  try    ShowBatContentCheck.Checked := AValue;  finally    FUpdating := False;  end;end;procedure TSettingsForm.RepositoryButtonClick(Sender: TObject);begin  ShellExecute(    Handle,    'open',    'https://github.com/aik3n/LaguNETbi',    nil,    nil,    SW_SHOWNORMAL  );end;end.