      Color = clWhite
      ParentBackground = False
      object StatusLabel: TLabel
        Left = 14
        Top = 13
        Width = 520
        Height = 24
        Caption = 'Prueba visual. Sin cambios en tu red.'
        Font.Size = 9
        Font.Color = 7760478
