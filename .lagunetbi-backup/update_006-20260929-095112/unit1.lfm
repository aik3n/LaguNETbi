object Form1: TForm1
  Left = 200
  Top = 90
  Width = 900
  Height = 720
  Caption = 'LaguNET bi'
  ClientHeight = 720
  ClientWidth = 900
  Font.Name = 'Segoe UI'
  Font.Size = 10
  Position = poScreenCenter
  BorderStyle = bsSingle
  BorderIcons = [biSystemMenu, biMinimize]
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  OnClose = FormClose
  object Sidebar: TPanel
    Left = 0
    Top = 0
    Width = 248
    Height = 720
    BevelOuter = bvNone
    Color = 3350804
    ParentBackground = False
    Align = alLeft
    object BrandLabel: TLabel
      Left = 24
      Top = 30
      Width = 400
      Height = 24
      Caption = 'LaguNET'
      Font.Size = 24
      Font.Color = clWhite
      ParentFont = False
      Font.Style = [fsBold]
    end
    object TaglineLabel: TLabel
      Left = 26
      Top = 72
      Width = 400
      Height = 24
      Caption = 'bi  /  Tu red, a tu manera'
      Font.Size = 10
      Font.Color = 13153442
      ParentFont = False
    end
    object ProfilesLabel: TLabel
      Left = 26
      Top = 144
      Width = 400
      Height = 24
      Caption = 'SCRIPTS'
      Font.Size = 9
      Font.Color = 13153442
      ParentFont = False
    end
    object ProfileList: TListBox
      Left = 16
      Top = 179
      Width = 216
      Height = 195
      BorderStyle = bsNone
      Color = 3350804
      Font.Color = clWhite
      Font.Size = 12
      ParentFont = False
      ItemHeight = 44
      Style = lbOwnerDrawFixed
      Items.Strings = (
        '   Oficina.bat'
        '   PLC Linea 1.bat'
        '   DHCP.bat'
      )
      ItemIndex = 0
      OnClick = SelectProfile
      TabOrder = 0
    end
    object CountLabel: TLabel
      Left = 26
      Top = 405
      Width = 400
      Height = 24
      Caption = '3 scripts de ejemplo'
      Font.Size = 10
      Font.Color = 13153442
      ParentFont = False
    end
    object VersionLabel: TLabel
      Left = 26
      Top = 620
      Width = 400
      Height = 24
      Caption = 'LaguNET bi  /  UI 001'
      Font.Size = 9
      Font.Color = 13153442
      ParentFont = False
    end
  end
  object Content: TPanel
    Left = 248
    Top = 0
    Width = 652
    Height = 720
    BevelOuter = bvNone
    Color = 16447733
    ParentBackground = False
    Align = alClient
    object Header: TPanel
      Left = 32
      Top = 20
      Width = 580
      Height = 44
      BevelOuter = bvNone
      Color = 16313309
      ParentBackground = False
      object PreviewLabel: TLabel
        Left = 16
        Top = 13
        Width = 430
        Height = 24
        Caption = 'EDITOR DE SCRIPT  /  Datos de ejemplo'
        Font.Size = 10
        Font.Color = 9717792
        ParentFont = False
      end
    end
    object ProfileTitle: TLabel
      Left = 32
      Top = 86
      Width = 500
      Height = 36
      Caption = 'Oficina'
      Font.Size = 24
      Font.Color = 3350804
      ParentFont = False
      Font.Style = [fsBold]
    end
    object SubtitleLabel: TLabel
      Left = 34
      Top = 128
      Width = 500
      Height = 24
      Caption = 'La misma funcionalidad basica de LaguNET.'
      Font.Size = 10
      Font.Color = 7760478
      ParentFont = False
    end
    object AdapterLabel: TLabel
      Left = 34
      Top = 174
      Width = 400
      Height = 24
      Caption = 'ADAPTADOR DE RED'
      Font.Size = 9
      Font.Color = 7760478
      ParentFont = False
    end
    object Adapter: TComboBox
      Left = 32
      Top = 198
      Width = 580
      Height = 34
      Style = csDropDownList
      Items.Strings = (
        'Ethernet  -  Adaptador de ejemplo'
        'Wi-Fi  -  Adaptador de ejemplo'
      )
      ItemIndex = 0
      Text = 'Ethernet  -  Adaptador de ejemplo'
      TabOrder = 0
    end
    object AutomaticBox: TCheckBox
      Left = 32
      Top = 246
      Width = 580
      Height = 26
      Caption = 'Obtener la configuracion automaticamente (DHCP)'
