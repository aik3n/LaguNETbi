      TabOrder = 1
    end
    object AddressLabel: TLabel
      Left = 34
      Top = 289
      Width = 250
      Height = 24
      Caption = 'Direccion IP'
      Font.Size = 10
      Font.Color = 3350804
      ParentFont = False
    end
    object AddressEdit: TEdit
      Left = 32
      Top = 314
      Width = 260
      Height = 34
      Text = '192.168.1.120'
      Font.Size = 11
      ParentFont = False
      TabOrder = 2
    end
    object MaskLabel: TLabel
      Left = 326
      Top = 289
      Width = 250
      Height = 24
      Caption = 'Mascara de subred'
      Font.Size = 10
      Font.Color = 3350804
      ParentFont = False
    end
    object MaskEdit: TEdit
      Left = 324
      Top = 314
      Width = 288
      Height = 34
      Text = '255.255.255.0'
      Font.Size = 11
      ParentFont = False
      TabOrder = 3
    end
    object GatewayLabel: TLabel
      Left = 34
      Top = 365
      Width = 250
      Height = 24
      Caption = 'Puerta de enlace'
      Font.Size = 10
      Font.Color = 3350804
      ParentFont = False
    end
    object GatewayEdit: TEdit
      Left = 32
      Top = 390
      Width = 260
      Height = 34
      Text = '192.168.1.1'
      Font.Size = 11
      ParentFont = False
      TabOrder = 4
    end
    object WifiBox: TCheckBox
      Left = 324
      Top = 365
      Width = 288
      Height = 24
      Caption = 'Conectar a red Wi-Fi'
      Checked = True
      State = cbChecked
      OnClick = ToggleWifi
      TabOrder = 5
    end
    object WifiCombo: TComboBox
      Left = 324
      Top = 390
      Width = 288
      Height = 34
      Style = csDropDownList
      Items.Strings = (
        'Oficina'
        'Mantenimiento'
        'Sin seleccionar'
      )
      ItemIndex = 0
      Text = 'Oficina'
      TabOrder = 6
    end
    object PingBox: TCheckBox
      Left = 32
      Top = 449
      Width = 260
      Height = 24
      Caption = 'Test Ping'
      Checked = True
      State = cbChecked
      OnClick = TogglePing
      TabOrder = 7
    end
    object PingEdit: TEdit
      Left = 32
      Top = 474
      Width = 580
      Height = 34
      Text = '192.168.1.1'
      Font.Size = 11
      ParentFont = False
