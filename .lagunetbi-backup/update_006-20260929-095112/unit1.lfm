      object ApplyButton: TButton
        Left = 346
        Top = 52
        Width = 220
        Height = 42
        Caption = 'Establecer'
        OnClick = PreviewAction
        TabOrder = 1
      end
    end
  end
  object TrayMenu: TPopupMenu
    Left = 80
    Top = 664
    object ScriptsMenuItem: TMenuItem
      Caption = 'Scripts'
    end
    object ScriptsRefreshItem: TMenuItem
      Caption = 'Actualizar scripts'
      OnClick = RefreshScriptsMenu
    end
    object ScriptsSeparator: TMenuItem
      Caption = '-'
    end
    object ShowMenuItem: TMenuItem
      Caption = 'LaguNET Config'
      Default = True
      OnClick = ShowFromTray
    end
    object HideMenuItem: TMenuItem
      Caption = 'Ocultar ventana'
      OnClick = HideToTray
    end
    object TraySeparator: TMenuItem
      Caption = '-'
    end
    object ExitMenuItem: TMenuItem
      Caption = 'Salir'
      OnClick = ExitFromTray
    end
  end
  object TrayIcon: TTrayIcon
    Left = 144
    Top = 664
    Hint = 'LaguNET bi - Doble clic para abrir'
    OnDblClick = ShowFromTray
    OnMouseUp = TrayMouseUp
  end
end
